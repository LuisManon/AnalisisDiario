{
  "name": "loto-mas-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "experiment:kino": "node --experimental-strip-types scripts/run-kino-experiment.ts",
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "evaluate:kino-v13": "node --experimental-strip-types scripts/evaluate-super-kino-v13.ts",
    "evaluate:kino-v131": "node --experimental-strip-types scripts/evaluate-super-kino-v13.ts 10 100",
    "evaluate:kino-v132": "node --experimental-strip-types scripts/evaluate-super-kino-v13.ts 10 100",
    "evaluate:kino-v133": "node --experimental-strip-types scripts/evaluate-super-kino-v13.ts 10 100",
    "evaluate:kino-v133-ratios": "node --experimental-strip-types scripts/evaluate-super-kino-v13.ts 10 1000 none hybrid",
    "evaluate:kino-v133-final": "node --experimental-strip-types scripts/evaluate-super-kino-v13.ts 10 10000 none final"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  }
